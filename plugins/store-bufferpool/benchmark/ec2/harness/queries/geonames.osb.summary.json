  {
   "body": {
    "query": {
     "function_score": {
      "functions": [
       {
        "script_score": {
         "script": {
          "lang": "expression",
          "source": "abs(ln(abs(doc['population']) + 1) + doc['location'].lon + doc['location'].lat) * _score"
         }
        }
       }
      ],
      "query": {
       "match_all": {}
      }
     }
    }
   },
   "families": [],
   "name": "osb:expression",
   "params": {},
   "source": "osb:geonames/operations/default.json",
   "type": "search"
  },
  {
   "body": {
    "query": {
     "function_score": {
      "functions": [
       {
        "script_score": {
         "script": {
          "lang": "painless",
          "source": "Math.abs(Math.log(Math.abs((int)((List)doc.population).get(0)) + 1) + (double)(doc.location.lon) * (double)(doc.location.lat))/_score"
         }
        }
       }
      ],
      "query": {
       "match_all": {}
      }
     }
    }
   },
   "families": [],
   "name": "osb:painless_static",
