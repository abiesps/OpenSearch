{
  "corpus": "nyc_taxis",
  "time_field": "pickup_datetime",
  "keyword_fields": [
    "payment_type",
    "vendor_id",
    "rate_code_id",
    "store_and_fwd_flag",
    "trip_type",
    "cab_color"
  ],
  "numeric_fields": [
    "total_amount",
    "trip_distance",
    "passenger_count",
    "tip_amount"
  ],
  "text_fields": [
    "vendor_name"
  ],
  "osb": {
    "workload": "nyc_taxis",
    "ops_files": [
      "operations/default.json"
    ],
    "params": {}
  },
  "reference_op": "gen:range_pickup_datetime_1d",
  "ingest_bulk_ops": {
    "append": [
      "index"
    ]
  },
  "create_index_settings": {
    "index.codec": "best_compression",
    "index.refresh_interval": "30s",
    "index.translog.flush_threshold_size": "4g"
  },
  "known_rejected_docs": {
    "count": 1,
    "reason": "the workload maps tip_amount as half_float (max 65504); one corpus document has tip_amount 3950588.8 and every OpenSearch build rejects it with HTTP 400 (stock ingest: br-nyctaxis/ingest.json doc_count_check)"
  },
  "note": "fields by ROLE only; values are discovered from the data by queries.py discover (fixed rank/percentile rules)",
  "date_fields": [
    "dropoff_datetime"
  ]
}
