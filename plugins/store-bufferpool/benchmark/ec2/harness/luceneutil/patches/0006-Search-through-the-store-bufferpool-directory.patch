+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.nio.file.Path;
+import org.apache.lucene.store.Directory;
+
+/**
+ * coldpath harness: the OpenSearch store-bufferpool plugin's directory (-dirImpl BufferPoolDirectory). The plugin jar,
+ * its dependencies and the harness shim (org.opensearch.plugin.store.bufferpool.LuceneutilBufferPool) are on the run
+ * classpath (luceneutil/lib); they are called by reflection so luceneutil compiles without them. One block cache per
+ * JVM, configured by -Dcoldpath.bp.* (see the shim).
+ */
+public final class ColdpathBufferPool {
+  private static final String SHIM = "org.opensearch.plugin.store.bufferpool.LuceneutilBufferPool";
+  private static volatile boolean used;
+
+  private ColdpathBufferPool() {}
+
+  private static Object call(String name, Class<?>[] types, Object... args) {
+    try {
+      Method m = Class.forName(SHIM).getMethod(name, types);
+      return m.invoke(null, args);
+    } catch (InvocationTargetException e) {
+      Throwable c = e.getCause();
+      if (c instanceof RuntimeException re) {
+        throw re;
+      }
+      throw new IllegalStateException(c);
+    } catch (ReflectiveOperationException e) {
+      throw new IllegalStateException("-dirImpl BufferPoolDirectory needs the store-bufferpool plugin and the coldpath shim on the classpath", e);
+    }
+  }
+
+  public static Directory open(Path path) {
+    used = true;
+    return (Directory) call("open", new Class<?>[] {Path.class}, path);
+  }
+
+  /** True once a bufferpool directory was opened in this JVM. */
+  public static boolean used() {
+    return used;
+  }
+
+  public static void clear() {
+    call("clear", new Class<?>[0]);
+  }
+
+  public static long cachedBlocks() {
+    return (Long) call("cachedBlocks", new Class<?>[0]);
+  }
+
+  public static long waitPrefetchIdle(long timeoutMillis) {
+    return (Long) call("waitPrefetchIdle", new Class<?>[] {long.class}, timeoutMillis);
+  }
+
+  public static String statsJson() {
+    return (String) call("statsJson", new Class<?>[0]);
+  }
+}
diff --git a/src/main/perf/ColdpathCold.java b/src/main/perf/ColdpathCold.java
index 9707e7a7..72aa94e4 100644
--- a/src/main/perf/ColdpathCold.java
+++ b/src/main/perf/ColdpathCold.java
@@ -56,6 +56,8 @@ public final class ColdpathCold {
   private static String preResidency;
   private static String preSnapshot;
   private static String preReset;
+  private static String preBp;
+  private static long preBpCached;
   private static long preResident;
   private static long count;
 
@@ -135,18 +137,43 @@ public final class ColdpathCold {
     preResidency = call("GET", "/cache/residency?" + arm + "&uuids=" + q(System.getProperty("coldpath.cold.uuids", "")));
     Matcher m = RESIDENT.matcher(preResidency);
     preResident = m.find() ? Long.parseLong(m.group(1)) : -1;
+    preBp = null;
+    preBpCached = -1;
+    if (ColdpathBufferPool.used()) {
+      // bufferpool directory: no prefetch left running, every cached block dropped (POST /_bufferpool/cache/_clear),
+      // then the page-cache drop above already ran; the cache must hold 0 blocks when the task starts
+      ColdpathBufferPool.waitPrefetchIdle(60_000L);
+      ColdpathBufferPool.clear();
+      preBpCached = ColdpathBufferPool.cachedBlocks();
+      preBp = ColdpathBufferPool.statsJson();
+    }
     preSnapshot = call("GET", "/snapshot?" + arm);
+    String trace = System.getProperty("coldpath.cold.trace", "");
+    if (trace.isEmpty() == false) {
+      // every device read of the task: NFS READ RPCs (Amazon EFS) or block read requests (Amazon EBS)
+      call("POST", "/trace/" + trace + "/_start?" + arm);
+    }
   }
 
   /** Records the task's run time with the clear, the residency and the IO counters around it. */
   public static synchronized void afterTask(Task task) {
     String arm = "arm=" + q(System.getProperty("coldpath.cold.arm", ""));
+    String postBp = null;
+    if (preBp != null) {
+      // prefetch reads issued by the task count as its reads: wait until they finished before the counters are read
+      ColdpathBufferPool.waitPrefetchIdle(60_000L);
+      postBp = ColdpathBufferPool.statsJson();
+    }
+    String trace = System.getProperty("coldpath.cold.trace", "");
+    String traced = trace.isEmpty() ? "null" : call("POST", "/trace/" + trace + "/_stop?" + arm + "&uuids=" + q(System.getProperty("coldpath.cold.uuids", "")));
     String post = call("GET", "/snapshot?" + arm);
     long tolerance = Long.getLong("coldpath.cold.residencyTolerance", 0L);
-    boolean ok = preResident >= 0 && preResident <= tolerance;
+    boolean ok = preResident >= 0 && preResident <= tolerance && (preBp == null || preBpCached == 0);
     log.println("{\"n\":" + (count++) + ",\"category\":" + json(task.getCategory()) + ",\"task\":" + json(task.toString())
         + ",\"run_ms\":" + (task.runTimeNanos / 1e6) + ",\"resident_bytes\":" + preResident + ",\"cold_ok\":" + ok + ",\"cold_protocol\":\"jit-warm\",\"caches_reset\":" + preReset
-        + ",\"drop\":" + preDrop + ",\"residency\":" + preResidency + ",\"pre\":" + preSnapshot + ",\"post\":" + post + "}");
+        + ",\"drop\":" + preDrop + ",\"residency\":" + preResidency + ",\"pre\":" + preSnapshot + ",\"post\":" + post
+        + ",\"bp_cached_blocks\":" + (preBp == null ? "null" : Long.toString(preBpCached)) + ",\"bp_pre\":" + (preBp == null ? "null" : preBp)
+        + ",\"bp_post\":" + (postBp == null ? "null" : postBp) + ",\"trace\":\"" + trace + "\",\"read_sizes\":" + traced + "}");
   }
 
   private static String json(String s) {
