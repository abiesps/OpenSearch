+
+import java.io.IOException;
+import java.io.PrintStream;
+import java.io.UncheckedIOException;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpResponse;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.time.Duration;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Strict per-task cold mode of the coldpath harness. Before every task, outside the task's timed region, the coldpath
+ * agent on this host pages out this JVM's mappings of the index files (MMapDirectory pages stay cached while mapped),
+ * syncs and drops the page cache ({@code POST /cache/drop?pageout=1}); then the page-cache residency of the index files
+ * is checked with mincore ({@code GET /cache/residency}) and the device / NFS counters are snapshotted
+ * ({@code GET /snapshot}). After the task the counters are snapshotted again. One JSON line per task goes to
+ * {@code -Dcoldpath.cold.log} (not stdout: luceneutil rejects a large stdout). Enabled by {@code -Dcoldpath.cold.agent};
+ * needs one task at a time ({@code -numConcurrentQueries 1}), checked by SearchPerfTest.
+ * Properties: coldpath.cold.agent (http://127.0.0.1:9700), coldpath.cold.tokenFile, coldpath.cold.arm (the agent arm
+ * whose data_path holds the index), coldpath.cold.uuids (index directory names under data_path/indices),
+ * coldpath.cold.residencyTolerance (bytes, default 0: not one page of the index files may be resident when a task starts),
+ * coldpath.cold.dropRounds (default 5: the agent repeats pageout + sync + drop_caches until mincore finds no resident page of
+ * the index files; one pass can leave a few pages that were faulted just before it), coldpath.cold.log.
+ */
+public final class ColdpathCold {
+  private static final String AGENT = System.getProperty("coldpath.cold.agent", "");
+  private static final Pattern RESIDENT = Pattern.compile("\"resident_bytes\"\\s*:\\s*(\\d+)");
+  private static HttpClient client;
+  private static String token;
+  private static PrintStream log;
+  private static String preDrop;
+  private static String preResidency;
+  private static String preSnapshot;
+  private static long preResident;
+  private static long count;
+
+  private ColdpathCold() {}
+
+  public static boolean enabled() {
+    return AGENT.isEmpty() == false;
+  }
+
+  private static synchronized void init() throws IOException {
+    if (client != null) {
+      return;
+    }
+    client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(30)).build();
+    String tokenFile = System.getProperty("coldpath.cold.tokenFile");
+    token = tokenFile == null ? "" : Files.readString(Paths.get(tokenFile)).trim();
+    String logPath = System.getProperty("coldpath.cold.log");
+    if (logPath == null) {
+      throw new IllegalArgumentException("-Dcoldpath.cold.log is required with -Dcoldpath.cold.agent");
+    }
+    log = new PrintStream(Files.newOutputStream(Paths.get(logPath)), true, StandardCharsets.UTF_8);
+  }
+
+  private static String call(String method, String pathAndQuery) {
+    try {
+      HttpRequest.Builder b = HttpRequest.newBuilder(URI.create(AGENT + pathAndQuery))
+          .timeout(Duration.ofMinutes(15)).header("X-Coldpath-Token", token);
+      b = method.equals("POST") ? b.POST(HttpRequest.BodyPublishers.noBody()) : b.GET();
+      HttpResponse<String> r = client.send(b.build(), HttpResponse.BodyHandlers.ofString());
+      if (r.statusCode() / 100 != 2) {
+        throw new IllegalStateException("coldpath agent " + method + " " + pathAndQuery + " -> " + r.statusCode() + " " + r.body());
+      }
+      return r.body();
+    } catch (IOException e) {
+      throw new UncheckedIOException(e);
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+      throw new IllegalStateException(e);
+    }
+  }
+
+  private static String q(String v) {
+    return URLEncoder.encode(v, StandardCharsets.UTF_8);
+  }
+
+  /** Drops the caches and verifies them, before the task starts (not timed). */
+  public static synchronized void beforeTask(Task task) throws IOException {
+    init();
+    String arm = "arm=" + q(System.getProperty("coldpath.cold.arm", ""));
+    String uuids = "uuids=" + q(System.getProperty("coldpath.cold.uuids", ""));
+    preDrop = call("POST", "/cache/drop?pageout=1&until_empty=" + Integer.getInteger("coldpath.cold.dropRounds", 5) + "&" + uuids + "&" + arm);
+    preResidency = call("GET", "/cache/residency?" + arm + "&uuids=" + q(System.getProperty("coldpath.cold.uuids", "")));
+    Matcher m = RESIDENT.matcher(preResidency);
+    preResident = m.find() ? Long.parseLong(m.group(1)) : -1;
+    preSnapshot = call("GET", "/snapshot?" + arm);
+  }
+
+  /** Records the task's run time with the clear, the residency and the IO counters around it. */
+  public static synchronized void afterTask(Task task) {
+    String arm = "arm=" + q(System.getProperty("coldpath.cold.arm", ""));
+    String post = call("GET", "/snapshot?" + arm);
+    long tolerance = Long.getLong("coldpath.cold.residencyTolerance", 0L);
+    boolean ok = preResident >= 0 && preResident <= tolerance;
+    log.println("{\"n\":" + (count++) + ",\"category\":" + json(task.getCategory()) + ",\"task\":" + json(task.toString())
+        + ",\"run_ms\":" + (task.runTimeNanos / 1e6) + ",\"resident_bytes\":" + preResident + ",\"cold_ok\":" + ok
+        + ",\"drop\":" + preDrop + ",\"residency\":" + preResidency + ",\"pre\":" + preSnapshot + ",\"post\":" + post + "}");
+  }
+
+  private static String json(String s) {
+    StringBuilder b = new StringBuilder("\"");
+    for (char c : s.toCharArray()) {
+      if (c == '"' || c == '\\') {
+        b.append('\\').append(c);
+      } else if (c < 0x20) {
+        b.append(String.format("\\u%04x", (int) c));
+      } else {
+        b.append(c);
+      }
+    }
+    return b.append('"').toString();
+  }
+}
diff --git a/src/main/perf/SearchPerfTest.java b/src/main/perf/SearchPerfTest.java
index 8917d61c..47aa0d8f 100755
--- a/src/main/perf/SearchPerfTest.java
