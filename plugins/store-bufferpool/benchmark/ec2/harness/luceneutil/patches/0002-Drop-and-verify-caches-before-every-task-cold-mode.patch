@@ -270,6 +270,9 @@ public class SearchPerfTest {
     final String analyzer = args.getString("-analyzer");
     final String tasksFile = args.getString("-taskSource");
     final int numConcurrentQueries = args.getInt("-numConcurrentQueries");
+    if (ColdpathCold.enabled() && numConcurrentQueries != 1) {
+      throw new IllegalArgumentException("coldpath per-task cold mode needs -numConcurrentQueries 1, got " + numConcurrentQueries);
+    }
     final String fieldName = args.getString("-field");
     final boolean printHeap = args.getFlag("-printHeap");
     final boolean doPKLookup = args.getFlag("-pk");
diff --git a/src/main/perf/TaskThreads.java b/src/main/perf/TaskThreads.java
index 16509654..5ad84e08 100644
--- a/src/main/perf/TaskThreads.java
+++ b/src/main/perf/TaskThreads.java
@@ -153,7 +153,16 @@ public class TaskThreads {
           // each time.  or, could we somehow "fix this in post"?  are there dedup
           // tools/regexps/something?  Java mission control somehow dedups these
           // annoyingly named anon lambdas...
+          // coldpath harness, strict per-task cold mode: caches dropped and verified before the task, outside its
+          // timed region (RunTask times only task.go)
+          final boolean cold = ColdpathCold.enabled();
+          if (cold) {
+            ColdpathCold.beforeTask(task);
+          }
           executor.submit(new RunTask(tasks, task, indexState, taskParser)).get();
+          if (cold) {
+            ColdpathCold.afterTask(task);
+          }
 
           task.threadID = threadID;
         }
