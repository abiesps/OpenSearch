   private final Map<String,SortedSetDocValuesReaderState> ssdvFacetStates = new HashMap<>();
 
+  /**
+   * coldpath harness, strict cold mode: drops every per-JVM structure that a task builds from index data and that
+   * later tasks reuse, so each cold task rebuilds it from storage like a cold query on a fresh node: the SSDV facet
+   * reader states (their OrdinalMap over all segments, the analog of OpenSearch's global ordinals; rebuilt lazily by
+   * getSortedSetReaderState), the taxonomy reader (reopened on its directory: fresh ordinal / label caches and parallel
+   * arrays) and the per-thread PK lookup states (cached TermsEnums). Returns what was dropped, for the cold log.
+   */
+  public synchronized String coldpathResetCaches() throws IOException {
+    int ssdv = ssdvFacetStates.size();
+    ssdvFacetStates.clear();
+    int pk = pkLookupStates.size() + pointsPKLookupStates.size() + pkLookupWithTermStateStates.size();
+    pkLookupStates.clear();
+    pointsPKLookupStates.clear();
+    pkLookupWithTermStateStates.clear();
+    boolean taxo = false;
+    if (taxoReader instanceof org.apache.lucene.facet.taxonomy.directory.DirectoryTaxonomyReader old) {
+      taxoReader = new org.apache.lucene.facet.taxonomy.directory.DirectoryTaxonomyReader(old.getInternalIndexReader().directory());
+      old.close();
+      taxo = true;
+    }
+    return "{\"ssdv_states\":" + ssdv + ",\"pk_states\":" + pk + ",\"taxonomy_reopened\":" + taxo + "}";
+  }
+
   public synchronized SortedSetDocValuesReaderState getSortedSetReaderState(String facetGroupField) throws IOException {
     SortedSetDocValuesReaderState result = ssdvFacetStates.get(facetGroupField);
     if (result == null) {
