+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import org.apache.lucene.codecs.Codec;
+
+/**
+ * Per-field points format for the Indexer (coldpath harness): {@code -Dcoldpath.pointsFormat=Lucene90Split:f1,f2}
+ * writes the named one-dimensional points fields in the Lucene fork's split BKD format (the "B" index variant). The
+ * codec that does it ({@code perf.ColdpathSplitPoints}) is only in the POC Lucene's private luceneutil copy (stock Lucene
+ * has no split format), so it is looked up by name; without the property the Indexer's codec is used unchanged.
+ */
+public final class ColdpathPointsFormat {
+  public static final String PROPERTY = "coldpath.pointsFormat";
+
+  private ColdpathPointsFormat() {}
+
+  public static Codec wrap(Codec codec) {
+    String spec = System.getProperty(PROPERTY, "");
+    if (spec.isBlank()) {
+      return codec;
+    }
+    int colon = spec.indexOf(':');
+    String format = colon < 0 ? spec : spec.substring(0, colon);
+    if (format.equals("Lucene90Split") == false || colon < 0) {
+      throw new IllegalArgumentException("-D" + PROPERTY + "=" + spec + ": expected Lucene90Split:<field>,<field>...");
+    }
+    Set<String> fields = new LinkedHashSet<>(Arrays.asList(spec.substring(colon + 1).split(",")));
+    try {
+      Class<?> c = Class.forName("perf.ColdpathSplitPoints");
+      Codec wrapped = (Codec) c.getMethod("wrap", Codec.class, Set.class).invoke(null, codec, fields);
+      System.out.println("COLDPATH points format Lucene90Split for fields " + fields + " codec " + wrapped.getName());
+      return wrapped;
+    } catch (ClassNotFoundException e) {
+      System.out.println("COLDPATH points format NOT AVAILABLE: no split points format in this Lucene build");
+      System.exit(ColdpathSwitches.EXIT_NOT_AVAILABLE);
+      return codec;
+    } catch (ReflectiveOperationException e) {
+      throw new IllegalStateException(e);
+    }
+  }
+}
